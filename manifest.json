{
  "manifest_version": 3,
  "name": "MarketMute",
  "version": "0.5.0",
  "description": "Highlight and locally mute sellers on Facebook Marketplace and Dubizzle.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.facebook.com/*", "https://*.dubizzle.com/*"],
  "background": {
    "scripts": ["core.js", "resolver.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*.dubizzle.com/*"],
      "js": ["dubizzle-page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/marketplace/*"],
      "js": ["facebook-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/marketplace/*"],
      "js": ["core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://*.dubizzle.com/*"],
      "js": ["core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "marketmute@local",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      },
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "1254": "icon.png"
  },
  "incognito": "not_allowed"
}
